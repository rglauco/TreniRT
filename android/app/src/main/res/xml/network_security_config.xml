<?xml version="1.0" encoding="utf-8"?>
<!-- Il traffico in chiaro è consentito solo verso ViaggiaTreno, che non offre HTTPS
     (https://www.viaggiatreno.it risponde con un redirect 301 verso http://). Ogni altra
     connessione, compresa la fonte dati Italo, resta obbligatoriamente HTTPS. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">www.viaggiatreno.it</domain>
    </domain-config>
</network-security-config>
